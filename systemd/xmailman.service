[Unit]
Description=xMailman Mailing List Manager
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/xmailman serve
Restart=on-failure
RestartSec=5

# Configuration
Environment=XMAILMAN_CONFIG=/etc/xmailman/config.yaml

# User
User=xmailman
Group=xmailman

# Data directory
StateDirectory=xmailman

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/xmailman

[Install]
WantedBy=multi-user.target
