# Build output
/xlistman
/e2eseed
/dist/

# Editor/IDE
/.vscode/
web/.vscode/

# Local development (generated, untracked)
/xlistman.yaml
/xlistman.db
/xlistman.db-shm
/xlistman.db-wal

# Frontend e2e suite (generated report; scenarios live in web/tests/t*.md)
/web/tests/report.md

# Frontend SPA build (generated by `pnpm build` / `make web`; Docker builds it).
# The committed .gitkeep keeps the directory present for go:embed in a fresh
# checkout.
/web/build/*
!/web/build/.gitkeep
